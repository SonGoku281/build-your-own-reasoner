# ── LLM endpoint ──────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint: llama.cpp server, vLLM, or a hosted API.
BASE_URL=http://localhost:8081/v1

# Model to query. Try a small model (e.g. qwen3-4b) to see the voting
# advantage — weaker models make more mistakes for self-consistency to fix.
MODEL=gemma-4-12b-v2

# Token budget for ONE completion. Reasoning models emit hidden thinking
# before the visible answer, and it counts against this budget. Too small
# (e.g. 2048) and the model runs out of tokens mid-thought → empty answers.
MAX_TOKENS=8192

# Seconds to wait for a response. First call pays model cold-load.
REQUEST_TIMEOUT=600

# ── Sampling (the voting machinery) ───────────────────────────────────────
# Temperature for self-consistency chains. Must be > 0 — temperature creates
# diversity, diversity makes voting meaningful.
SC_TEMPERATURE=0.9

# How many independent chains to sample per problem for the vote.
SC_SAMPLES=5

# Greedy baseline: temperature 0 = deterministic, one opinion.
GREEDY_TEMPERATURE=0.0
